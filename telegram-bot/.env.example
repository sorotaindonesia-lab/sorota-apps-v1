# Telegram Bot environment example
APP_ENV=local
APP_PORT=3002

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-public-ngrok-or-production-url
TELEGRAM_WEBHOOK_PATH=/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
TELEGRAM_API_BASE_URL=https://api.telegram.org

# Backend
BACKEND_BASE_URL=http://localhost:8000
BACKEND_INTERNAL_API_KEY=replace_with_same_internal_api_key

# Logging
LOG_LEVEL=INFO
