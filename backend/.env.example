# Backend environment example
APP_ENV=local
APP_NAME=Sorota Backend
APP_PORT=8000
APP_DEBUG=true

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_PROMPT_VERSION=v1

# Internal service auth
INTERNAL_API_KEY=replace_with_random_secret

# WhatsApp bot service
WHATSAPP_BOT_BASE_URL=http://localhost:3001
WHATSAPP_BOT_INTERNAL_TOKEN=replace_with_random_secret

# Early warning
ENABLE_EARLY_WARNING_AUTO_SEND=false
EARLY_WARNING_MAX_PER_CUSTOMER_PER_DAY=1
EARLY_WARNING_MAX_PER_CUSTOMER_PER_WEEK=3

# Logging
LOG_LEVEL=INFO
