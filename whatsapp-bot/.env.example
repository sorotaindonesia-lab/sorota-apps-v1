# WhatsApp Bot environment example
APP_ENV=local
APP_PORT=3001

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_VERSION=v19.0

# Backend
BACKEND_BASE_URL=http://localhost:8000
BACKEND_INTERNAL_API_KEY=replace_with_same_internal_api_key

# Templates
WHATSAPP_WELCOME_TEMPLATE_NAME=sorota_welcome_v1
WHATSAPP_TEMPLATE_LANGUAGE=id

# Logging
LOG_LEVEL=INFO
